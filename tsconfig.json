{
  "compilerOptions": {
    "outDir": "./dist/",
    // ts-loader compiles files one at a time, so TS 6 infers a different
    // "common source directory" per file and errors with TS5011 unless the
    // root is pinned. The repo root is the right answer for every service.
    "rootDir": "./",
    "sourceMap": true,
    "noImplicitAny": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es6",
    "jsx": "react",
    "allowSyntheticDefaultImports": true,
    // TypeScript 6 changed the default of this to `true`. It has to stay off
    // here: with it on, `import * as express from 'express'` stops being
    // callable (express, express-session, memoizee, request-promise,
    // classnames and raven-for-redux are all `export =` functions consumed
    // that way), and the emit would start inserting interop helpers that
    // neither jest's swc transform -- configured with `noInterop: true` to
    // match -- nor the existing bundles expect. Turning it on is a codebase-
    // wide change, not part of this upgrade.
    "esModuleInterop": false,
    "strictNullChecks": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noUnusedLocals": true,
    // `moduleResolution: node10` is deprecated in 6.0 but is still the correct
    // algorithm here: the emit target is CommonJS and `module: node16`/
    // `bundler` would force `esModuleInterop` on, which this codebase does not
    // want (`import * as express from 'express'` must stay callable). This
    // acknowledges the deprecation; it does not suppress any type error.
    "ignoreDeprecations": "6.0",
    // No `baseUrl`: as of TS 6 `paths` entries resolve relative to this file.
    "paths": {
      "api/*": ["./services/api/src/*"],
      "app/*": ["./services/app/src/*"],
      "shared/*": ["./shared/*"],
      // cheerio 1.x exposes its htmlparser2-only build (no parse5, no undici)
      // only through the `./slim` entry of its `exports` map, which the
      // `node10` resolver above cannot read. Node, webpack 5 and jest all
      // resolve it natively; this teaches tsc where the declarations are.
      // See shared/Cheerio.tsx for why the slim build is the one we want.
      "cheerio/slim": ["./node_modules/cheerio/dist/commonjs/slim.d.ts"]
    },
    "skipLibCheck": true,
    // TypeScript 6 stopped pulling every package in node_modules/@types into
    // the global scope. These are the ones this repo relies on for *ambient*
    // declarations: `process`/`Buffer`, the `jest`/`expect` globals used by the
    // shared Testing helpers, `$` in the quests/admin entrypoints, the
    // `stripe`/`Stripe` globals from Stripe's script tag (@types/stripe-v3 is
    // Stripe.js, the browser library loaded from a <script> tag -- unrelated to
    // the `stripe` node SDK, which ships its own types). @types/cheerio is
    // gone: cheerio 1.x ships types, so the global `Cheerio`/`CheerioAPI`
    // interfaces are replaced by the real ones re-exported from
    // shared/Cheerio.tsx and imported where they are used. Everything else is
    // reached through a normal import and needs no entry here.
    "types": ["node", "jest", "jquery", "stripe-v3"]
  },
  "include": ["services/**/*", "shared/**/*"],
  "exclude": [
    "dist",
    "node_modules",
    "app/src/quests",
    "app/plugins",
    "app/platforms",
    "**/*.test.ts",
    "**/*.test.tsx",
    "www"
  ]
}
